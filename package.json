{
  "name": "build-ultra",
  "displayName": "Build Ultra",
  "description": "AI coding assistant — Ultra AI by Build Ultra",
  "version": "0.0.1",
  "publisher": "mirror",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:buildUltra.chat",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildUltra",
          "title": "Build Ultra",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "buildUltra": [
        {
          "id": "buildUltra.chat",
          "name": "Ultra AI",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node webview/esbuild.mjs && npm run build:webview:css",
    "build:webview:css": "tailwindcss -i ./webview/src/index.css -o ./media/webview.css --minify",
    "watch:webview": "node webview/esbuild.mjs --watch",
    "pretest": "npm run compile && npm run build:webview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "posthog-js": "^1.368.1",
    "posthog-node": "^5.29.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "zustand": "^5.0.12"
  }
}
